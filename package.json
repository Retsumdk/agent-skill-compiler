{
  "name": "agent-skill-compiler",
  "version": "1.0.0",
  "description": "Compiles agent skill definitions: dependency resolution, content-addressed cache, and batched execution plans",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": { "asc": "dist/cli.js" },
  "files": ["dist", "demo-output.txt", "README.md", "LICENSE"],
  "scripts": {
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "demo": "bun src/demo.ts",
    "verify:demo": "bun run scripts/verify-demo.ts"
  },
  "engines": { "node": ">=20" },
  "keywords": ["ai-agents", "skills", "compiler", "dependency-resolution", "content-addressed-cache", "execution-planning", "typescript"],
  "license": "MIT",
  "author": { "name": "Retsumdk", "url": "https://github.com/Retsumdk" },
  "repository": { "type": "git", "url": "git+https://github.com/Retsumdk/agent-skill-compiler.git" },
  "bugs": { "url": "https://github.com/Retsumdk/agent-skill-compiler/issues" },
  "homepage": "https://github.com/Retsumdk/agent-skill-compiler#readme",
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
